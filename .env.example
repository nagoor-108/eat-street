# ==========================================
# Eat Street Kakinada — Environment Config
# ==========================================

# Flask Security Secret Key
SECRET_KEY=eatstreet_secret_key_prod_2026

# Database
SQLALCHEMY_DATABASE_URI=sqlite:///eatstreet.db

# ==========================================
# SMTP Email Configuration (Forgot Password OTP)
# ==========================================
# Example for Gmail:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
# Use 16-character App Password generated from Google Account (Security -> 2-Step Verification -> App Passwords)
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER="Eat Street Kakinada <your-email@gmail.com>"

# Optional AI Rag Assistant (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
